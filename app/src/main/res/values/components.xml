<resources>
    <style name="Label" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/paletteText</item><item name="android:textSize">16sp</item>
    </style>
    <style name="Label.Muted"><item name="android:textColor">?attr/paletteMuted</item><item name="android:textSize">15sp</item><item name="android:tag">muted</item></style>
    <style name="Label.Kicker">
        <item name="android:tag">muted</item>
        <item name="android:textColor">?attr/paletteMuted</item><item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.09</item><item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Label.Heading">
        <item name="android:textSize">38sp</item><item name="android:fontFamily">serif</item>
        <item name="android:letterSpacing">-0.035</item><item name="android:includeFontPadding">false</item>
    </style>
    <style name="Label.Subhead"><item name="android:textSize">20sp</item><item name="android:fontFamily">sans-serif-medium</item></style>
    <style name="Control" parent="@android:style/Widget.Material.Button">
        <item name="android:tag">outline</item>
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">50dp</item><item name="android:minWidth">48dp</item>
        <item name="android:background">@drawable/button_outline</item><item name="android:textColor">?attr/paletteText</item>
        <item name="android:stateListAnimator">@null</item><item name="android:elevation">0dp</item>
        <item name="android:textSize">16sp</item><item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item><item name="android:letterSpacing">0</item>
        <item name="android:paddingLeft">16dp</item><item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">9dp</item><item name="android:paddingBottom">9dp</item>
    </style>
    <style name="Control.Navigation">
        <item name="android:tag">navigation</item>
        <item name="android:background">@drawable/button_navigation</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Control.Primary"><item name="android:tag">primary</item><item name="android:background">@drawable/button_primary</item><item name="android:textColor">?attr/paletteOnAccent</item></style>
    <style name="Control.ChatSuggestion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:drawableEnd">@drawable/ic_arrow_right</item>
        <item name="android:drawableTint">?attr/paletteAccent</item>
        <item name="android:drawablePadding">8dp</item>
    </style>
    <style name="Control.Hero"><item name="android:tag">heroAction</item><item name="android:background">@drawable/button_cream</item><item name="android:textColor">?attr/paletteHeroButtonText</item></style>
    <style name="ModeOption">
        <item name="android:tag">mode</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:background">@drawable/mode_option</item>
        <item name="android:button">@null</item>
        <item name="android:textColor">@color/mode_option_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:saveEnabled">false</item>
    </style>
    <style name="ThemeOption">
        <item name="android:tag">colorOption</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/theme_option</item>
        <item name="android:button">@null</item>
        <item name="android:drawableEnd">?android:attr/listChoiceIndicatorSingle</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textColor">?attr/paletteText</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:saveEnabled">false</item>
    </style>
    <style name="ColorSlider" parent="@android:style/Widget.Material.SeekBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">8dp</item>
        <item name="android:maxHeight">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:splitTrack">false</item>
    </style>
</resources>
