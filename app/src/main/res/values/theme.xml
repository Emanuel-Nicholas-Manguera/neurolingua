<resources>
    <string name="app_name">Neurolingua</string>
    <color name="paper">#FCFAF7</color>
    <color name="ink">#322837</color>
    <color name="muted">#665B68</color>
    <color name="plum">#653B6E</color>
    <color name="lilac">#F2EAF2</color>
    <color name="line">#E2D9E0</color>
    <color name="cream">#FFF8FC</color>
    <color name="on_plum">@color/cream</color>
    <color name="on_cream">#402447</color>
    <color name="control_highlight">#22653B6E</color>
    <color name="legacy_navigation_bar">#322837</color>
    <bool name="light_system_bars">true</bool>

    <style name="AppTheme" parent="BaseAppTheme"/>
    <style name="PlatformTheme" parent="android:style/Theme.Material.Light.NoActionBar"/>
    <style name="PlatformAlertTheme" parent="android:style/Theme.Material.Light.Dialog.Alert"/>
    <style name="AnswerDialogTheme" parent="PlatformAlertTheme">
        <item name="android:colorAccent">@color/plum</item>
        <item name="android:colorBackgroundFloating">@color/paper</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>
    <style name="BaseAppTheme" parent="PlatformTheme">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/plum</item>
        <item name="android:alertDialogTheme">@style/AnswerDialogTheme</item>
        <item name="android:colorControlHighlight">@color/control_highlight</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/legacy_navigation_bar</item>
    </style>
</resources>
