<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <ripple android:color="?attr/paletteControlRipple">
            <item>
                <shape>
                    <solid android:color="?attr/paletteSurfaceVariant"/>
                    <stroke android:width="2dp" android:color="?attr/paletteAccent"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
        </ripple>
    </item>
    <item android:drawable="@drawable/button_outline"/>
</selector>
