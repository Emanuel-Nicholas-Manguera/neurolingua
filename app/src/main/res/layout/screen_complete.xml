<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <include layout="@layout/brand"/>
        <Space android:layout_width="1dp" android:layout_height="20dp" android:layout_weight="1"/>
        <TextView style="@style/Label.Kicker" android:text="@string/assessment"/>
        <TextView style="@style/Label.Heading" android:layout_marginTop="9dp" android:text="@string/test_complete"/>
        <TextView style="@style/Label" android:layout_marginTop="14dp" android:text="@string/completion"/>
        <Button style="@style/Control.Primary" android:id="@+id/home" android:layout_width="match_parent"
            android:layout_marginTop="24dp" android:text="@string/back_home"/>
        <Space android:layout_width="1dp" android:layout_height="20dp" android:layout_weight="1"/>
    </LinearLayout>
</ScrollView>
