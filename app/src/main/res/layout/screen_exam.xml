<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <Button style="@style/Control" android:id="@+id/home" android:text="←" android:textSize="23sp"
                android:contentDescription="@string/back_home"/>
            <TextView style="@style/Label.Subhead" android:layout_marginStart="12dp" android:text="@string/assessment"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:gravity="center_vertical">
            <TextView style="@style/Label.Kicker" android:layout_width="0dp" android:layout_weight="1" android:text="@string/orientation"/>
            <TextView style="@style/Label.Muted" android:id="@+id/question_number"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
            android:progressTint="@color/plum" android:progressBackgroundTint="@color/line"/>
        <TextView style="@style/Label.Heading" android:id="@+id/prompt" android:layout_width="match_parent"
            android:layout_marginTop="26dp" android:gravity="center" android:textSize="34sp"/>
        <Space android:layout_width="1dp" android:layout_height="18dp" android:layout_weight="1"/>
        <View android:layout_width="112dp" android:layout_height="112dp" android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no" android:background="@drawable/orb"/>
        <TextView style="@style/Label.Subhead" android:id="@+id/turn_status" android:layout_width="match_parent"
            android:accessibilityLiveRegion="polite" android:gravity="center" android:layout_marginTop="17dp"/>
        <TextView style="@style/Label.Muted" android:id="@+id/turn_hint" android:layout_width="match_parent"
            android:gravity="center" android:layout_marginTop="5dp"/>
        <Space android:layout_width="1dp" android:layout_height="18dp" android:layout_weight="1"/>
        <TextView style="@style/Label" android:id="@+id/transcript" android:layout_width="match_parent"
            android:background="@drawable/surface_lilac" android:textSize="21sp" android:padding="15dp"
            android:textIsSelectable="true" android:visibility="gone" android:layout_marginBottom="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <Button style="@style/Control" android:id="@+id/secondary_action" android:layout_marginEnd="8dp"/>
            <Button style="@style/Control.Primary" android:id="@+id/primary_action"
                android:layout_width="0dp" android:layout_weight="1"/>
        </LinearLayout>
        <Button style="@style/Control" android:id="@+id/alternate_input" android:layout_width="match_parent"
            android:layout_marginTop="4dp" android:background="?android:attr/selectableItemBackground"
            android:textColor="@color/plum" android:text="@string/type_answer"/>
        <Button style="@style/Control" android:id="@+id/system_speech" android:layout_width="match_parent"
            android:text="@string/system_speech" android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
