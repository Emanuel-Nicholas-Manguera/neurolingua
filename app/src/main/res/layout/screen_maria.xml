<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:focusableInTouchMode="true">

    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="64dp" android:paddingHorizontal="16dp" android:paddingVertical="6dp">
        <Button android:id="@+id/home" style="@style/Control.Navigation" android:layout_width="48dp"
            android:layout_gravity="start|center_vertical" android:padding="0dp" android:gravity="center"
            android:text="@string/back_symbol" android:textSize="23sp" android:contentDescription="@string/back_home"/>
        <TextView style="@style/Label.Subhead" android:layout_width="match_parent"
            android:layout_gravity="center" android:layout_marginHorizontal="54dp"
            android:gravity="center" android:text="@string/ask_maria"/>
    </FrameLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:tag="divider" android:alpha="0.45" android:background="?attr/paletteOutline"/>

    <ScrollView android:id="@+id/chat_scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="8dp">

            <LinearLayout android:id="@+id/chat_welcome" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
                android:orientation="vertical" android:paddingVertical="24dp">
                <ImageView android:layout_width="80dp" android:layout_height="80dp" android:padding="18dp"
                    android:tag="accentCircle" android:background="@drawable/assistant_button"
                    android:src="@drawable/ic_help" android:importantForAccessibility="no"/>
                <TextView style="@style/Label.Heading" android:layout_marginTop="16dp"
                    android:textSize="34sp" android:gravity="center" android:text="@string/maria_greeting"/>
                <TextView style="@style/Label.Muted" android:layout_marginTop="8dp"
                    android:gravity="center" android:text="@string/help_intro"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/chat_messages" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:visibility="gone"/>
            <Button android:id="@+id/chat_suggestion_toggle" style="@style/Control"
                android:tag="accent" android:background="?android:attr/selectableItemBackground"
                android:textColor="?attr/paletteAccent" android:textSize="15sp" android:minHeight="48dp"
                android:paddingHorizontal="6dp" android:layout_marginTop="4dp"
                android:drawableEnd="@drawable/chat_disclosure" android:drawablePadding="6dp"
                android:text="@string/suggested_questions"/>
            <LinearLayout android:id="@+id/chat_suggestions" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <Button android:id="@+id/suggest_score" style="@style/Control.ChatSuggestion" android:text="@string/ask_score"/>
                <Button android:id="@+id/suggest_missed" style="@style/Control.ChatSuggestion" android:text="@string/ask_missed"/>
                <Button android:id="@+id/suggest_count" style="@style/Control.ChatSuggestion" android:text="@string/ask_count"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginVertical="8dp"
        android:paddingStart="18dp" android:paddingEnd="4dp" android:paddingVertical="4dp"
        android:tag="composer" android:background="@drawable/chat_composer"
        android:gravity="center_vertical" android:orientation="horizontal">
        <EditText android:id="@+id/chat_input" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="48dp" android:paddingStart="0dp" android:paddingEnd="8dp"
            android:background="@null" android:textColor="?attr/paletteText" android:textColorHint="?attr/paletteMuted"
            android:textSize="16sp" android:singleLine="true" android:inputType="textCapSentences"
            android:imeOptions="actionSend|flagNoExtractUi" android:maxLength="300"
            android:importantForAutofill="no" android:saveEnabled="false" android:hint="@string/ask_hint"/>
        <ImageButton android:id="@+id/chat_send" android:layout_width="48dp" android:layout_height="48dp"
            android:tag="accentCircle" android:background="@drawable/assistant_button" android:scaleType="center"
            android:src="@drawable/ic_send_message" android:contentDescription="@string/send"
            android:tooltipText="@string/send"/>
    </LinearLayout>
</LinearLayout>
