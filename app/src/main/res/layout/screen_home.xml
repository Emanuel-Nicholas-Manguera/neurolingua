<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="24dp" android:orientation="vertical">

        <LinearLayout android:id="@+id/home_header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <include layout="@layout/brand"/>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <Button android:id="@+id/help" style="@style/Control" android:text="@string/help"/>
        </LinearLayout>

        <TextView style="@style/Label.Kicker" android:layout_marginTop="26dp" android:text="@string/home"/>
        <TextView style="@style/Label.Heading" android:layout_marginTop="3dp" android:text="@string/check_in"/>

        <FrameLayout android:id="@+id/assessment_card" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="23dp" android:background="@drawable/hero">
            <ImageView android:layout_width="136dp" android:layout_height="158dp" android:layout_gravity="top|end"
                android:importantForAccessibility="no" android:src="@drawable/hero_lines"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="22dp">
                <TextView style="@style/Label.Heading" android:maxWidth="200dp"
                    android:textColor="@color/cream" android:text="@string/assessment"/>
                <TextView style="@style/Label" android:maxWidth="232dp" android:layout_marginTop="10dp"
                    android:textColor="@color/cream" android:text="@string/intro"/>
                <TextView style="@style/Label.Muted" android:layout_marginTop="12dp"
                    android:textColor="@color/cream" android:text="@string/question_count"/>
                <Button android:id="@+id/start_test" style="@style/Control.Hero"
                    android:layout_marginTop="18dp" android:layout_width="match_parent" android:text="@string/start"/>
            </LinearLayout>
        </FrameLayout>

        <Space android:layout_width="1dp" android:layout_height="24dp" android:layout_weight="1"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line"/>
        <TextView style="@style/Label.Subhead" android:layout_marginTop="18dp" android:text="@string/last_test"/>
        <TextView android:id="@+id/last_result" style="@style/Label.Muted"
            android:layout_marginTop="8dp" android:text="@string/no_test"/>
        <Button android:id="@+id/open_record" style="@style/Control"
            android:layout_width="match_parent" android:layout_marginTop="8dp" android:visibility="gone"/>
        <TextView android:id="@+id/pending" style="@style/Label" android:layout_marginTop="12dp"
            android:text="@string/pending_test" android:visibility="gone"/>
        <Button android:id="@+id/review" style="@style/Control" android:layout_width="match_parent"
            android:layout_marginTop="6dp" android:text="@string/review_test" android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
